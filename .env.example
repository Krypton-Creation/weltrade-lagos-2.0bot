# Telegram and database
BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgres://user:password@host:5432/dbname
ADMIN_CHAT_ID=your_admin_chat_id_here
ADMIN_USER_IDS=your_admin_user_ids_here
# Channel for /post. Set to unused if there is no channel.
CHANNEL_ID=your_channel_id_here

# Event details
EVENT_NAME=your_event_name_here
EVENT_DATE_ISO=2026-11-28
EVENT_TIME_LABEL=your_event_time_label_here
EVENT_VENUE=your_event_venue_here

# Links for the three step sequence
GROUP_URL=your_group_url_here
EVENTBRITE_URL=your_eventbrite_url_here
WHATSAPP_GROUP_URL=your_whatsapp_group_url_here

# Optional. Leave unset to keep the old backup link message off.
# BACKUP_GROUP_URL=your_backup_group_url_here

# Seconds between steps. Default 60 when unset.
STEP2_DELAY_SECONDS=60
STEP3_DELAY_SECONDS=60
